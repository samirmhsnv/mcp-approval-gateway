{
  "name": "mcp-approval-gateway",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents read freely but routes every write through human approval on Telegram.",
  "license": "MIT",
  "author": "Samir Mammadhasanov",
  "type": "module",
  "bin": {
    "mcp-approval-gateway": "dist/index.js"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "human-in-the-loop",
    "approval",
    "telegram",
    "postgres",
    "claude"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "start": "node dist/index.js",
    "schema": "node scripts/gen-schema.mjs",
    "demo": "node examples/demo-client.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.17.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samirmhsnv/mcp-approval-gateway.git"
  }
}
